<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
	  <RootNamespace></RootNamespace>
    <SignAssembly>true</SignAssembly>
    <LangVersion>10</LangVersion>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <AssemblyName>MP.AbstractionsLibAnalyzer</AssemblyName>
	  <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
	  <EnableDefaultCompileItems>False</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="./DiagnosticIds.cs" />
    <Compile Include="./AnalyzerUtils.cs" />
    <Compile Include="./AttributesAnalysis/*.cs" />
  </ItemGroup>

</Project>