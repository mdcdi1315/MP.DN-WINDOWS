<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<MDCDI1315-RES>
	<xsd:schema id="MDCDI1315-RES" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
		<xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
		<xsd:element name="MDCDI1315-RES">
			<xsd:complexType>
				<xsd:choice maxOccurs="unbounded">
					<xsd:element name="MDCDI1315-XML-RESOURCE-TABLE" maxOccurs="1" minOccurs="1">
						<xsd:complexType>
							<xsd:annotation>
								<xsd:documentation>Indicates the header of mdcdi1315' Custom XML Resource Format.</xsd:documentation>
							</xsd:annotation>
							<xsd:sequence>
								<xsd:element name="Version" type="xsd:int" minOccurs="1" maxOccurs="1" />
								<xsd:element name="Magic" type="xsd:string" minOccurs="1" maxOccurs="1" />
								<xsd:element name="SupportedFormatsMask" type="xsd:int" minOccurs="1" maxOccurs="1" />
								<xsd:element name="CurrentHeaderVersion" type="xsd:int" minOccurs="1" maxOccurs="1" />
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
					<xsd:element name="ResData">
						<xsd:annotation>
							<xsd:documentation>Defines the root element that contains all the resources that are represented by this file.</xsd:documentation>
						</xsd:annotation>
						<xsd:complexType>
							<xsd:sequence>
								<xsd:element name="Data" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>The Data element provides a single resource definition. Each definition is then written to the target resource file.</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="Value" type="xsd:string" minOccurs="1" maxOccurs="1">
												<xsd:annotation>
													<xsd:documentation>Provides the resource value of the current resource element.</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="Comment" type="xsd:string" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Provides an optional comment of the current resource.</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute ref="xml:space" />
										<xsd:attribute name="name" type="xsd:string" use="required">
											<xsd:annotation>
												<xsd:documentation>Defines the resource name of the current resource.</xsd:documentation>
											</xsd:annotation>
										</xsd:attribute>
										<xsd:attribute name="type" use="required">
											<xsd:annotation>
												<xsd:documentation>Defines the type under this resource will be saved in the target file.</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="xsd:token">
													<xsd:enumeration value="String">
														<xsd:annotation>
															<xsd:documentation>Indicates that the data should be saved as a string inside the resource file.</xsd:documentation>
														</xsd:annotation>
													</xsd:enumeration>
													<xsd:enumeration value="ByteArray">
														<xsd:annotation>
															<xsd:documentation>Indicates that the data should be saved in raw binary after decoded by base-64 inside the resource file.</xsd:documentation>
														</xsd:annotation>
													</xsd:enumeration>
													<xsd:enumeration value="FileReference">
														<xsd:annotation>
															<xsd:documentation>Indicates that the data should be saved based on the contents to an external file. The Value element describes the location and the required settings to save it to the target resource file.</xsd:documentation>
														</xsd:annotation>
													</xsd:enumeration>
													<xsd:enumeration value="Object">
														<xsd:annotation>
															<xsd:documentation>Indicates that the data are saved as a .NET object serialized with base-64 to the Value element.</xsd:documentation>
														</xsd:annotation>
													</xsd:enumeration>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:attribute>
										<xsd:attribute name="dotnettype" use="optional" type="xsd:string">
											<xsd:annotation>
												<xsd:documentation>Defines the .NET type to decode the base-64 binary serialized object as. Required when the type attribute is set to 'Object'.</xsd:documentation>
											</xsd:annotation>
										</xsd:attribute>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
						</xsd:complexType>
					</xsd:element>
				</xsd:choice>
			</xsd:complexType>
		</xsd:element>
	</xsd:schema>
	<MDCDI1315-XML-RESOURCE-TABLE>
		<Version>2</Version>
		<Magic>mdcdi1315.XML.RESOURCE.NET</Magic>
		<SupportedFormatsMask>3</SupportedFormatsMask>
		<CurrentHeaderVersion>1</CurrentHeaderVersion>
	</MDCDI1315-XML-RESOURCE-TABLE>
	<ResData>
