<Window x:Class="MP.SingleFilePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MP"
        mc:Ignorable="d"
        Title="SingleFilePlayerWindow" Height="250" MinHeight="250" MaxHeight="250" MinWidth="1075" MaxWidth="1075" Width="1075"
        Background="Black" Foreground="White" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <ControlTemplate x:Key="PlayerButtonsTemplate" TargetType="Button">
            <Grid>
                <!-- Change stroke thickness from 0 to one to see and edit the controls. -->
                <Rectangle x:Name="backgroundElement" Fill="{TemplateBinding Background}" StrokeThickness="0" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Stroke="AliceBlue" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Fill" TargetName="backgroundElement" Value="LimeGreen"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <DockPanel Background="Black">
        <Canvas DockPanel.Dock="Bottom" Height="116">
            <Label Name="TimeElapsed" Foreground="White" Content="00:00:00.00" HorizontalAlignment="Left" Canvas.Top="5" VerticalAlignment="Center" Canvas.Left="4" />
            <ProgressBar x:Name="TimeBar" BorderThickness="0.4" Height="21" Background="Black" Canvas.Left="79" Canvas.Top="7" Width="893" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Label Name="TimeRemaining" Foreground="White" Content="--:--:--.--" Canvas.Left="981" Canvas.Top="5" />
            <Button x:Name="PlayButton" Canvas.Left="485.5" Canvas.Top="50.5" Height="46" Width="64" Background="Black" Click="PlayButton_Click"  HorizontalAlignment="Center" VerticalAlignment="Top" Template="{StaticResource ResourceKey=PlayerButtonsTemplate}">
                <Image x:Name="PlayImage" />
            </Button>
            <Button x:Name="TenSecsBack" Width="30" Height="20" Click="TenSecsBack_Click" Background="Black" Canvas.Left="430" Canvas.Top="62" HorizontalAlignment="Center" VerticalAlignment="Top" Template="{StaticResource ResourceKey=PlayerButtonsTemplate}">
                <Image x:Name="TenSecsBackImage" Stretch="Fill" />
            </Button>
            <Button x:Name="TenSecsAhead" Width="30" Height="20" Click="TenSecsAhead_Click" Background="Black" Canvas.Left="574" Canvas.Top="62" HorizontalAlignment="Left" VerticalAlignment="Center" Template="{StaticResource ResourceKey=PlayerButtonsTemplate}">
                <Image x:Name="TenSecsAheadImage" Stretch="Fill" />
            </Button>
            <Button x:Name="StopButton" Click="StopButton_Click" Width="34" Background="Black" Height="34" Canvas.Left="1003" Canvas.Top="68" Template="{StaticResource ResourceKey=PlayerButtonsTemplate}">
                <Image x:Name="StopImage" Stretch="Fill" />
            </Button>
            <Button x:Name="RepeatButton" Click="RepeatButton_Click" Width="34" Background="Black" Height="34" Canvas.Left="938" Canvas.Top="68" Template="{StaticResource ResourceKey=PlayerButtonsTemplate}">
                <Image x:Name="RepeatImage" Stretch="Fill" />
            </Button>
            <DockPanel x:Name="TrackInfoPanel" Width="410" Height="70" Canvas.Left="10" Canvas.Top="40" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Visible">
                <Image x:Name="CoverImage" Stretch="Fill" Visibility="Visible" Width="104" Height="66" DockPanel.Dock="Left" />
                <Label x:Name="TrackTitle" FontSize="13.7" Padding="1.1" DockPanel.Dock="Top" Height="26" Foreground="White" Visibility="Visible" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed" />
                <Label x:Name="OtherData" FontSize="11" Padding="1" Foreground="White" />
            </DockPanel>
        </Canvas>
        <StackPanel>
            <Label x:Name="RightVolumeLabel" Content="Right Speaker:" Foreground="White" />
            <Slider x:Name="RightVolume" MouseEnter="RightVolume_MouseEnter"  MouseLeave="RightVolume_MouseLeave"  Maximum="100" Minimum="0" SmallChange="2" LargeChange="4" Height="20" />
            <Label x:Name="LeftVolumeLabel" Content="Left Speaker:" Foreground="White" />
            <Slider x:Name="LeftVolume" MouseEnter="LeftVolume_MouseEnter"  MouseLeave="LeftVolume_MouseLeave" Maximum="100" Minimum="0" SmallChange="2" LargeChange="4" Height="20" />
        </StackPanel>
    </DockPanel>
</Window>
